# Secrets and local environment files. Keep sanitized templates named .env.example.
.env
**/.env
.env.*
**/.env.*
!.env.example
!**/.env.example

# Private keys and common credential files. Example templates use other names.
*.pem
*.key
id_rsa
id_ed25519
credentials.json
secrets.json

# Python, Node and generated runtime files.
venv/
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/
node_modules/
dist/
*.log
*.tmp
*.bak
*~
.DS_Store
Thumbs.db

# Local Airflow configuration contains generated keys and connection data.
/airflow/config/airflow.cfg
/airflow/logs/
/airflow/chegada/*.csv

